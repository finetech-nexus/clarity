FROM node:20-alpine
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
ARG NEXT_PUBLIC_API_URL=http://localhost:8095
ARG CLARITY_API_UPSTREAM=
ARG NEXT_PUBLIC_KEYCLOAK_URL=https://iam.dev.sandbox.internal.nbank.fr/auth
ARG NEXT_PUBLIC_KEYCLOAK_REALM=internal
ARG NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=web-app
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV CLARITY_API_UPSTREAM=$CLARITY_API_UPSTREAM
ENV NEXT_PUBLIC_KEYCLOAK_URL=$NEXT_PUBLIC_KEYCLOAK_URL
ENV NEXT_PUBLIC_KEYCLOAK_REALM=$NEXT_PUBLIC_KEYCLOAK_REALM
ENV NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=$NEXT_PUBLIC_KEYCLOAK_CLIENT_ID
RUN npm run build
EXPOSE 3010
CMD ["npm", "start"]
